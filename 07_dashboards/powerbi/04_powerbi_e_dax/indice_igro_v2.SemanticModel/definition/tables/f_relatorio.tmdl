		annotation SummarizationSetBy = Automatic

	/// [Papel: Chave/Atributo] Sigla do órgão responsável pelo tratamento da manifestação. Relaciona f_relatorio à dimensão dOrgao_igro e serve como principal eixo institucional do IGRO.
	column sigla
		dataType: string
		lineageTag: f7596e7a-ca40-425b-88d5-3d149affd423
		summarizeBy: none
		sourceColumn: sigla

		annotation SummarizationSetBy = Automatic

	/// Subdivisão ou unidade interna do órgão à qual a manifestação foi encaminhada.
	column suborgao
		dataType: string
		lineageTag: a573378a-887c-4df4-b08c-3bd3768504b0
		summarizeBy: none
		sourceColumn: suborgao

		annotation SummarizationSetBy = Automatic

