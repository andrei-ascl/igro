		annotation SummarizationSetBy = Automatic

	/// Data da última revisão ou atualização de status da manifestação pelo órgão ou pela ouvidoria.
	column data_revisao
		dataType: dateTime
		formatString: General Date
		lineageTag: dd2b0adb-e183-4a06-aecf-46e2d8356077
