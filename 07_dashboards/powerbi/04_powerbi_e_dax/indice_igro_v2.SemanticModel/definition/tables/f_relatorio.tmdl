/// [Fato] Tabela central do modelo. Contém todas as manifestações registradas no SGOe — uma linha por manifestação, independente do status. Base principal para volume, tempo, procedência, recursos e relacionamento com pesquisas e respostas insatisfatórias.
table f_relatorio
	lineageTag: 1ef260cb-def5-48b1-a775-38f30eab2601

	/// Identificador numérico interno gerado pelo sistema. Utilizado como referência técnica complementar ao protocolo.
	column id_manifestacao
		dataType: int64
		formatString: 0
		lineageTag: 03eb4533-8d74-40ac-aadd-314662a507b2
		summarizeBy: sum
		sourceColumn: id_manifestacao

		annotation SummarizationSetBy = Automatic

	/// [Papel: Chave] Identificador único de negócio da manifestação no SGOe. Chave primária lógica da tabela f_relatorio e destino dos relacionamentos com f_pesquisa[protocolo] e f_insatisfatorias[protocolo].
	column protocolo
		dataType: string
		lineageTag: e5abad0c-f3ae-4f21-9778-ce1af5d7cb3f
		summarizeBy: none
		sourceColumn: protocolo

		annotation SummarizationSetBy = Automatic

	/// Data e hora em que a manifestação foi registrada no sistema. Ponto de partida para cálculo do TMR e dias de vida.
	column data_manifestacao
		dataType: dateTime
		formatString: General Date
		lineageTag: 78a00d6b-61f3-4a9b-965c-f45cc0c11a1d
		summarizeBy: none
		sourceColumn: data_manifestacao

		annotation SummarizationSetBy = Automatic

	/// Data e hora em que a manifestação foi encerrada pelo órgão. Usada para determinar manifestações finalizadas.
	column data_finalizacao
		dataType: dateTime
		formatString: General Date
		lineageTag: 91a81071-d137-4b82-ad64-f34549c2d9bc
