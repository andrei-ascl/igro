	partition f_insatisfatorias = m
		mode: import
		source =
				let
				    // Caminho da pasta de entrada
				    CaminhoPasta =
				        fnCaminhoEntrada(),
				
				    // Caminho completo do arquivo
				    CaminhoArquivo =
				        if Text.EndsWith(CaminhoPasta, "\") or Text.EndsWith(CaminhoPasta, "/")
				        then CaminhoPasta & "f_insatisfatorias.parquet"
				        else CaminhoPasta & "\f_insatisfatorias.parquet",
				
				    // Carregar arquivo Parquet
				    Fonte =
				        Parquet.Document(
				            File.Contents(CaminhoArquivo)
				        ),
				
				    // Renomear colunas para padrão minúsculo
				    ColunasRenomeadas =
				        Table.RenameColumns(
				            Fonte,
				            {
				                {"Protocolo", "protocolo"},
				                {"Data_manifestacao", "data_manifestacao"},
				                {"Data_finalizacao", "data_finalizacao"},
				                {"Data_revisao", "data_revisao"},
				                {"Sigla", "sigla"},
				                {"Sigilo", "sigilo"},
				                {"Dias_vida", "dias_vida"},
				                {"Dias_reativacao", "dias_reativacao"},
				                {"Dias_atraso", "dias_atraso"},
				                {"Tipo_manifestacao", "tipo_manifestacao"},
				                {"Municipio", "municipio"},
				                {"Tipificacao", "tipificacao"},
				                {"Sub_tipificacao", "sub_tipificacao"}
				            },
				            MissingField.Ignore
				        ),
				
				    // Definir tipos de dados
				    TiposDefinidos =
				        Table.TransformColumnTypes(
				            ColunasRenomeadas,
				            {
				                {"protocolo", type text},
				                {"data_manifestacao", type datetime},
				                {"data_finalizacao", type datetime},
				                {"data_revisao", type datetime},
				                {"sigla", type text},
				                {"sigilo", type text},
				                {"dias_vida", Int64.Type},
				                {"dias_reativacao", Int64.Type},
				                {"dias_atraso", Int64.Type},
				                {"tipo_manifestacao", type text},
				                {"municipio", type text},
				                {"tipificacao", type text},
				                {"sub_tipificacao", type text}
				            },
				            "pt-BR"
				        ),
				
				    // Padronizar sigla
				    SiglaPadronizada =
				        Table.ReplaceValue(
				            TiposDefinidos,
				            "GT",
				            "GOIAS TELECOM",
				            Replacer.ReplaceValue,
				            {"sigla"}
				        )
				
				in
				    SiglaPadronizada

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

